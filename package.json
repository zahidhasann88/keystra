{
  "name": "keystra",
  "version": "0.1.0",
  "description": "A tiny, framework-independent keyboard interaction engine: navigation, roving focus and selection for any DOM UI.",
  "keywords": [
    "keyboard",
    "navigation",
    "focus",
    "focus-management",
    "roving-tabindex",
    "accessibility",
    "a11y",
    "aria",
    "typeahead",
    "menu",
    "tabs",
    "grid",
    "tree",
    "command-palette",
    "vanilla-js",
    "typescript"
  ],
  "license": "MIT",
  "author": "Keystra contributors",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "unpkg": "./dist/index.global.js",
  "jsdelivr": "./dist/index.global.js",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./core": {
      "import": {
        "types": "./dist/core.d.ts",
        "default": "./dist/core.js"
      },
      "require": {
        "types": "./dist/core.d.cts",
        "default": "./dist/core.cjs"
      }
    },
    "./navigation": {
      "import": {
        "types": "./dist/navigation.d.ts",
        "default": "./dist/navigation.js"
      },
      "require": {
        "types": "./dist/navigation.d.cts",
        "default": "./dist/navigation.cjs"
      }
    },
    "./focus": {
      "import": {
        "types": "./dist/focus.d.ts",
        "default": "./dist/focus.js"
      },
      "require": {
        "types": "./dist/focus.d.cts",
        "default": "./dist/focus.cjs"
      }
    },
    "./selection": {
      "import": {
        "types": "./dist/selection.d.ts",
        "default": "./dist/selection.js"
      },
      "require": {
        "types": "./dist/selection.d.cts",
        "default": "./dist/selection.cjs"
      }
    },
    "./patterns": {
      "import": {
        "types": "./dist/patterns.d.ts",
        "default": "./dist/patterns.js"
      },
      "require": {
        "types": "./dist/patterns.d.cts",
        "default": "./dist/patterns.cjs"
      }
    },
    "./utils": {
      "import": {
        "types": "./dist/utils.d.ts",
        "default": "./dist/utils.js"
      },
      "require": {
        "types": "./dist/utils.d.cts",
        "default": "./dist/utils.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "sideEffects": false,
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:browser": "npm run build && node tests/browser/run.mjs",
    "bench": "npm run build && node benchmarks/run.mjs",
    "size": "npm run build && node scripts/size.mjs",
    "verify": "npm run typecheck && npm run test && npm run build && node scripts/verify-package.mjs",
    "prepublishOnly": "npm run verify"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@vitest/coverage-v8": "^5.0.5",
    "esbuild": "^0.28.2",
    "happy-dom": "^21.0.4",
    "hotkeys-js": "^4.0.10",
    "playwright-core": "^1.64.1",
    "roving-ux": "^1.0.5",
    "tinykeys": "^4.0.1",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vitest": "^5.0.5"
  }
}
